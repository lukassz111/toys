async function fetchDuckDuckGoData(query) {
  const response = await fetch(`https://duckduckgo.com/${encodeURIComponent(query)}&format=json&no_html=1`, {
    method: "GET",
    headers: { "Content-Type": "text/markdown", "User-Agent": "curl" },
  });
  if (!response.ok) {
    throw new Error(`Status ${response.status}`);
  }
  return await response.json();
}

async function queryOllama(prompt) {
  const ollamaUrl = "http://localhost:11434/api/chat";
  const ollamaModel = "gemma4:e2b"; // zmień na model, który masz zainstalowany
  const response = await fetch(ollamaUrl, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      model: ollamaModel,
      messages: [
        { "role": "user", "content": prompt }
      ],
      stream: false,
      temperature: 0.7,
      // Tools 
      tools: [
        {
          type: "function",
          function: {
            "name": "fetch_duck_duck_go",
            "description": "Fetch data from DuckDuckGo for a given query by api. Returns the result in JSON format.",
            "parameters": {
              "type": "object",
              "required": ["query"],
              "properties": {
                "query": {"type": "string", "description": "The search query for DuckDuckGo"}
              }
            }
          }
        }
      ]
    }),
  });

  if (!response.ok) {
    throw new Error(`Status ${response.status}`);
  }

  return await response.json();
}

