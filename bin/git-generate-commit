#!/usr/bin/env node
const { exec } = require('child_process');
const fs = require('fs');
const { exit } = require('process');

const generateCommitMessage = async () => {
  try {
    // Get staged files
    const stagedFiles = await new Promise((resolve, reject) => {
      exec('git diff --cached --name-only', (err, stdout) => {
        if (err) reject(err);
        resolve(stdout.trim().split('\n'));
      });
    });

    if (stagedFiles.length === 0) {
      console.log('No changes to commit');
      exit(0);
    }

    // Get diffs for each file
    const diffs = await Promise.all(
      stagedFiles.map(async file => {
        return new Promise((resolve, reject) => {
          exec(`git diff --cached -- ${file}`, (err, stdout) => {
            if (err) reject(err);
            resolve(stdout);
          });
        });
      })
    );

    // Format diffs for Ollama
    const formattedDiffs = diffs.map((diff, i) => {
      return `File: ${stagedFiles[i]}
${diff}`;
    }).join('\n\n');
    const prompt = `Generate a commit message for these changes:
${formattedDiffs}
`;
    // Send to Ollama API
    const response = await fetch('http://localhost:11434/api/generate', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        model: 'qwen3:8b',
        stream: false,
        prompt: prompt  
      })
    });

    const data = await response.json();
    const responseText = data.response;

    process.stdout.write(`${responseText.trim()}\n`);
  } catch (error) {
    console.error('Error:', error.message);
    exit(1);
  }
};

generateCommitMessage();